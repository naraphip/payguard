# Copy to .env at the repository root for Docker Compose.
# Generate a separate private token for each demo merchant.
PAYGUARD_DEMO_MERCHANT_A_TOKEN=
PAYGUARD_DEMO_MERCHANT_B_TOKEN=
PAYGUARD_DEMO_ADMIN_TOKEN=
# Optional, distinct from the admin token. Required for Platform Rule approval and rollback.
PAYGUARD_PLATFORM_RULE_CHECKER_TOKEN=

# Put OPENAI_API_KEY in backend/.env for the natural-language Rule Composer.
# OPENROUTER_API_KEY is reserved for Jev Decisions.
PAYGUARD_RULE_COMPOSER_ENABLED=false
PAYGUARD_RULE_COMPOSER_PROVIDER=openai
PAYGUARD_RULE_COMPOSER_MODEL=

# Optional booking operations actors and baseline threshold.
PAYGUARD_DEMO_ANALYST_A_TOKEN=
PAYGUARD_DEMO_ANALYST_A2_TOKEN=
PAYGUARD_DEMO_VIEWER_A_TOKEN=
PAYGUARD_DEMO_ANALYST_B_TOKEN=
PAYGUARD_DEMO_VIEWER_B_TOKEN=
PAYGUARD_DEMO_BASELINE_MIN_SAMPLES=

# Set live to use TypeSafe Jev for merchant checkout and scenario simulation.
PAYGUARD_AI_MODE=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL_PRIMARY=typesafe/jev-1.14

# Optional enrichment. Set true to enable provider lookups.
PAYGUARD_ENRICHMENT_ENABLED=false
PAYGUARD_IPAPI_IS_KEY=
PAYGUARD_PROXYCHECK_KEY=
PAYGUARD_ENRICHMENT_CACHE_SECRET=
PAYGUARD_EMAIL_MASTER_LOCAL=

# Put both sandbox keys in backend/.env. Only the public key reaches the browser.
# OMISE_PUBLIC_KEY=pkey_test_REPLACE_ME
# OMISE_SECRET_KEY=skey_test_REPLACE_ME
